# Laravel API origin, used only by the Next.js server (rewrites & SSR). Never prefix with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000

# Values below are readable in the browser: never put secrets here.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false
