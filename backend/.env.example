APP_NAME=RentACar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public origin seen by the browser (Next.js proxies /api to Laravel)
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (local: native PostgreSQL >= 16)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rentacar
DB_USERNAME=rentacar
DB_PASSWORD=

# Session / cache / queue: `database` locally and in CI; `redis` optional on the demo server
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Sanctum SPA (comma-separated host[:port] of the frontend)
SANCTUM_STATEFUL_DOMAINS=localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Public files (logos, car photos) are served at /storage through the frontend proxy.
# PUBLIC_STORAGE_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=rentacar_cache_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Initial accounts (used by seeders in later stories; never commit real values)
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
